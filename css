:root {
  --primary:#4f46e5;
  --academic:#2563eb;
  --event:#7c3aed;
  --urgent:#ef4444;
  --general:#6b7280;
}

body {
  margin:0;
  font-family:Segoe UI, sans-serif;
  background:#f3f4f6;
}

/* LOGIN */
#loginPage {
  height:100vh;
  display:flex;
  justify-content:center;
  align-items:center;
  background:linear-gradient(to right,#4f46e5,#6366f1);
}

.login-box {
  background:white;
  padding:30px;
  width:320px;
  border-radius:12px;
  box-shadow:0 20px 40px rgba(0,0,0,.2);
}

.login-box input, button {
  width:100%;
  padding:10px;
  margin-top:10px;
}

.password-box {
  position:relative;
}

.password-box i {
  position:absolute;
  right:12px;
  top:50%;
  transform:translateY(-50%);
  cursor:pointer;
}

#error {
  color:red;
  text-align:center;
}

#dashboard {
  display:none;
}

/* HEADER */
header {
  background:var(--primary);
  color:white;
  padding:15px;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

button {
  background:var(--primary);
  color:white;
  border:none;
  border-radius:8px;
  cursor:pointer;
}

button:hover {opacity:.9}

.container {
  padding:20px;
}

/* FORM */
form {
  background:white;
  padding:15px;
  border-radius:12px;
  margin-bottom:20px;
}

/* ANNOUNCEMENTS */
.cards {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:15px;
}

.card {
  background:white;
  padding:15px;
  border-radius:12px;
  box-shadow:0 4px 10px rgba(0,0,0,.1);
  position:relative;
}

.card .todayTag {
  position:absolute;
  top:10px;
  right:10px;
  background:#fde68a;
  color:#000;
  font-size:10px;
  padding:2px 6px;
  border-radius:8px;
}

.tag {
  padding:4px 10px;
  border-radius:20px;
  color:white;
  font-size:12px;
}

.Academic {background:var(--academic);}
.Event {background:var(--event);}
.Urgent {background:var(--urgent);}
.General {background:var(--general);}

/* CALENDAR */
.calendar {
  background:white;
  padding:15px;
  border-radius:12px;
  margin-top:20px;
}

#monthYear {
  text-align:center;
  font-weight:bold;
  margin-bottom:10px;
}

.calendar-grid {
  display:grid;
  grid-template-columns:repeat(7,1fr);
  gap:5px;
}

.day {
  padding:10px;
  text-align:center;
  border-radius:8px;
  cursor:pointer;
  transition:0.2s;
}

.day:hover {
  background:#e0e7ff;
}

.today {background:#fde68a;}
.past {background:#fecaca;}
.upcoming {background:#c7d2fe;}
.hasEvent {border:2px solid var(--primary);}
