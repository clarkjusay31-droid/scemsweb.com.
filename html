<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>SCEM School Website Announcement</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="stylesheet" href="style.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>

<!-- LOGIN -->
<div id="loginPage">
  <div class="login-box">
    <h2>SCEM Login</h2>
    <input type="email" id="email" placeholder="Email (@gfis.edu.ph)">
    <div class="password-box">
      <input type="password" id="password" placeholder="Password">
      <i class="fa-solid fa-eye" onclick="togglePassword()"></i>
    </div>
    <button onclick="login()">Login</button>
    <p id="error"></p>
  </div>
</div>

<!-- DASHBOARD -->
<div id="dashboard">
<header>
  <h2>SCEM School Website Announcement</h2>
  <button onclick="logout()">Logout</button>
</header>

<div class="container">

<!-- ADMIN FORM -->
<form id="adminForm">
  <h3>Create Announcement</h3>
  <input id="titleInput" placeholder="Title">
  <textarea id="descInput" placeholder="Description"></textarea>
  <select id="categoryInput">
    <option>Academic</option>
    <option>Event</option>
    <option>Urgent</option>
    <option>General</option>
  </select>
  <input type="date" id="dateInput">
  <button type="button" onclick="addAnnouncement()">Post</button>
</form>

<h3>Announcements</h3>
<button id="clearFilterBtn" onclick="clearFilter()" style="display:none;">Show All Announcements</button>
<div class="cards" id="announcements"></div>

<h3>School Events Calendar</h3>
<div class="calendar">
  <div id="monthYear"></div>
  <div class="calendar-grid" id="calendar"></div>
</div>

</div>
</div>

<script src="script.js"></script>
</body>
</html>
